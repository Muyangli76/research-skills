# Flexible publication defaults for generated analysis notebooks.
font.family: sans-serif
font.size: 15
mathtext.fontset: dejavusans

figure.dpi: 120
figure.facecolor: white
figure.edgecolor: white

axes.facecolor: white
axes.edgecolor: black
axes.linewidth: 1.8
axes.grid: False
axes.labelsize: 15
axes.labelpad: 6
axes.titlesize: 15
axes.titleweight: normal
axes.spines.left: True
axes.spines.right: True
axes.spines.bottom: True
axes.spines.top: True
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', '882255', '44AA99'])

lines.linewidth: 2.8
lines.markersize: 7
lines.markeredgewidth: 1.4

xtick.labelsize: 15
ytick.labelsize: 15
xtick.direction: out
ytick.direction: out
xtick.major.size: 6
ytick.major.size: 6
xtick.major.width: 1.6
ytick.major.width: 1.6
xtick.minor.size: 3
ytick.minor.size: 3
xtick.minor.width: 1.2
ytick.minor.width: 1.2

legend.fontsize: 15
legend.frameon: False
legend.handlelength: 2.5

savefig.dpi: 300
savefig.bbox: tight
savefig.facecolor: white
savefig.edgecolor: white
